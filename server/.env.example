# Port (Render sets this dynamically via $PORT)
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/user_analytics?retryWrites=true&w=majority

# Production Frontend URL
CLIENT_URL=https://smart-anaylsis.vercel.app

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=https://smart-anaylsis.vercel.app,http://localhost:5173,http://localhost:3000

# Environment mode
NODE_ENV=production
